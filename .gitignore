# Secrets & local data — never commit these
backend/.env
*.db
*.sqlite3
*.db-wal
*.db-shm

# Local Claude Code settings (machine-specific; may contain tokens/passwords)
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Trained models / downloaded weights
backend/trained_models/

# Frontend deps and build output (regenerated by `npm run build`)
node_modules/
frontend/dist/
backend/static/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
