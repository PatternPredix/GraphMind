# Copy to .env and adjust.

# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://annotator:CHANGE_ME@localhost:5432/annotation
# SQLite (development default):
DATABASE_URL=sqlite:///./annotation.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=720
ALLOW_OPEN_REGISTRATION=false
MODELS_DIR=./trained_models
DEFAULT_AUTO_ANNOTATE_THRESHOLD=20

# ML model choices
RE_BASE_MODEL=distilbert-base-uncased
# Alternatives: bert-base-uncased, SpanBERT/spanbert-base-cased
NER_BASE_MODEL=blank:en
# Alternative: en_core_web_trf (transformer pipeline) — first run
#   python -m spacy download en_core_web_trf
NER_TRAINING_ITERATIONS=30

# Embedding model for relation rules (BERT-family bi-encoder).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Default cosine-similarity threshold for relation rules (0..1).
DEFAULT_RELATION_RULE_THRESHOLD=0.55
